# Blank values keep the app in its explicit unconfigured state.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key: admin-created accounts/invitations and enabled email worker.
# NEVER rename this to NEXT_PUBLIC_*, log it, or commit actual values.
SUPABASE_SECRET_KEY=
# Exact canonical application origin; set separately for each deployment environment.
APP_URL=http://localhost:3000
# Feedback email worker: opt-in, server-only; Auth SMTP is a separate channel.
FEEDBACK_EMAIL_ENABLED=false
BREVO_API_KEY=
FEEDBACK_FROM_EMAIL=
# Independent random ASCII secret, 32-256 characters. Never put it in URL/client vars.
FEEDBACK_WORKER_SECRET=
